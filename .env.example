# Rename this file to .env and fill in your values

# Required - your OpenRouter API key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional - override the model. Defaults to the free Nemotron 3 Ultra tier.
# Paid tier (higher rate limits): nvidia/nemotron-3-ultra-550b-a55b
# Free tier (rate-limited):       nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional - only needed if using --jira-ticket
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token-here
